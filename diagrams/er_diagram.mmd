erDiagram
    USERS ||--o{ BOOKINGS : makes
    VENUES ||--o{ SCREENS : contains
    SCREENS ||--o{ SEATS : has
    EVENTS ||--o{ SHOWS : scheduled_as
    SCREENS ||--o{ SHOWS : hosts
    SHOWS ||--o{ BOOKINGS : receives
    BOOKINGS ||--o{ BOOKING_SEATS : contains
    SEATS ||--o{ BOOKING_SEATS : reserved_in
    BOOKINGS ||--o| PAYMENTS : paid_by
    BOOKINGS ||--o| TICKETS : generates

    USERS { int user_id PK string full_name string email string phone }
    VENUES { int venue_id PK string venue_name string city string address }
    SCREENS { int screen_id PK int venue_id FK string screen_name int total_seats }
    SEATS { int seat_id PK int screen_id FK string seat_row int seat_number string seat_type }
    EVENTS { int event_id PK string event_name string event_type int duration_minutes }
    SHOWS { int show_id PK int event_id FK int screen_id FK date show_date time start_time decimal base_price }
    BOOKINGS { int booking_id PK int user_id FK int show_id FK datetime booking_time string booking_status decimal total_amount }
    BOOKING_SEATS { int booking_seat_id PK int booking_id FK int seat_id FK decimal price }
    PAYMENTS { int payment_id PK int booking_id FK string payment_method decimal amount string payment_status }
    TICKETS { int ticket_id PK int booking_id FK string ticket_code datetime issued_at }
