digraph ER { graph [rankdir=LR, bgcolor="white", nodesep=0.5, ranksep=0.8]; node [shape=record, style=filled, fillcolor="#f3f6fb", fontname="Arial", fontsize=10]; edge [fontname="Arial", fontsize=9];
USERS [label="{USERS|PK user_id|full_name|email|phone}"]; VENUES [label="{VENUES|PK venue_id|venue_name|city|address}"]; SCREENS [label="{SCREENS|PK screen_id|FK venue_id|screen_name|total_seats}"]; SEATS [label="{SEATS|PK seat_id|FK screen_id|seat_row|seat_number|seat_type}"]; EVENTS [label="{EVENTS|PK event_id|event_name|event_type|duration_minutes}"]; SHOWS [label="{SHOWS|PK show_id|FK event_id|FK screen_id|show_date|start_time|base_price|status}"]; BOOKINGS [label="{BOOKINGS|PK booking_id|FK user_id|FK show_id|booking_time|status|total_amount}"]; BOOKING_SEATS [label="{BOOKING_SEATS|PK booking_seat_id|FK booking_id|FK seat_id|price}"]; PAYMENTS [label="{PAYMENTS|PK payment_id|FK booking_id|method|amount|status}"]; TICKETS [label="{TICKETS|PK ticket_id|FK booking_id|ticket_code|issued_at}"];
VENUES -> SCREENS [label="1:N"]; SCREENS -> SEATS [label="1:N"]; EVENTS -> SHOWS [label="1:N"]; SCREENS -> SHOWS [label="1:N"]; USERS -> BOOKINGS [label="1:N"]; SHOWS -> BOOKINGS [label="1:N"]; BOOKINGS -> BOOKING_SEATS [label="1:N"]; SEATS -> BOOKING_SEATS [label="1:N"]; BOOKINGS -> PAYMENTS [label="1:1"]; BOOKINGS -> TICKETS [label="1:1"]; }
